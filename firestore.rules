rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'habeshatilaye@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return ( !('email' in data) || (data.email is string && data.email.size() <= 200) ) &&
             ( !('balance' in data) || (data.balance is number) ) &&
             ( !('role' in data) || (data.role in ['user', 'admin']) ) &&
             ( !('fullName' in data) || (data.fullName == null || (data.fullName is string && data.fullName.size() <= 500)) ) &&
             ( !('address' in data) || (data.address == null || (data.address is string && data.address.size() <= 1000)) ) &&
             ( !('phoneNumber' in data) || (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) ) &&
             ( !('verificationDoc' in data) || (data.verificationDoc == null || (data.verificationDoc is string && data.verificationDoc.size() <= 10485760)) ) && // 10MB
             ( !('verificationStatus' in data) || (data.verificationStatus == null || data.verificationStatus in ['pending', 'verified', 'rejected', 'unsubmitted']) ) &&
             ( !('isVerified' in data) || (data.isVerified == null || data.isVerified is bool) ) &&
             ( !('tradeAction' in data) || (data.tradeAction == null || data.tradeAction is bool) );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                      isValidId(userId) && 
                      incoming().keys().hasAll(['email', 'balance', 'role', 'createdAt']) &&
                      isValidUser(incoming()) && 
                      (incoming().role == 'user' || (incoming().role == 'admin' && request.auth.token.email == 'habeshatilaye@gmail.com')) && 
                      incoming().balance == 0 &&
                      (incoming().createdAt is timestamp || incoming().createdAt == request.time);
      
      allow update: if (isOwner(userId) || isAdmin()) && 
                      isValidUser(incoming()) && (
        isAdmin() || 
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'fullName', 'phoneNumber', 'address', 'verificationDoc', 'verificationStatus']))
      ) && (
        isAdmin() || (
          (!('email' in incoming()) || incoming().email == existing().email) &&
          (!('role' in incoming()) || incoming().role == existing().role) &&
          (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)
        )
      );
      allow delete: if isAdmin();
    }

    // --- Transaction Validation ---
    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'status', 'createdAt']) &&
             data.userId is string &&
             data.type in ['deposit', 'trade', 'withdraw'] &&
             data.amount is number &&
             data.status in ['pending', 'completed', 'failed'] &&
             data.createdAt is timestamp &&
             ( !('symbol' in data) || (data.symbol is string && data.symbol.size() <= 100) ) &&
             ( !('details' in data) || (data.details is string && data.details.size() <= 1000) );
    }

    match /transactions/{transactionId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      
      allow create: if isSignedIn() && 
                      isValidId(transactionId) && 
                      isValidTransaction(incoming()) &&
                      isOwner(incoming().userId) &&
                      incoming().status in ['pending', 'completed', 'failed'] &&
                      incoming().createdAt == request.time;

      allow update: if isAdmin() && 
                      isValidTransaction(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasAny(['status', 'amount']);
    }

    // --- Settings Validation ---
    function isValidSettings(data) {
      return data.keys().hasAll(['btc_address', 'eth_address', 'sol_address', 'bnb_address', 'xrp_address', 'usdt_address']) &&
             data.keys().size() == 6 &&
             data.btc_address is string && data.btc_address.size() <= 128 &&
             data.eth_address is string && data.eth_address.size() <= 128 &&
             data.sol_address is string && data.sol_address.size() <= 128 &&
             data.bnb_address is string && data.bnb_address.size() <= 128 &&
             data.xrp_address is string && data.xrp_address.size() <= 128 &&
             data.usdt_address is string && data.usdt_address.size() <= 128;
    }

    match /settings/addresses {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidSettings(incoming());
    }

    // --- Support Chat Validation ---
    function isValidSupportMessage(data) {
      return data.keys().hasAll(['userId', 'senderId', 'text', 'isAdmin', 'createdAt']) &&
             data.userId is string &&
             data.senderId is string &&
             data.text is string && data.text.size() <= 2000 &&
             data.isAdmin is bool &&
             data.createdAt is timestamp;
    }

    match /support_messages/{messageId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidSupportMessage(incoming()) && (
        (isOwner(incoming().userId) && incoming().senderId == request.auth.uid && incoming().isAdmin == false) ||
        (isAdmin() && incoming().isAdmin == true)
      ) && incoming().createdAt == request.time;
    }

    // --- Admin List ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- News Validation ---
    function isValidNews(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt', 'author']) &&
             data.title is string && data.title.size() <= 500 &&
             data.content is string && data.content.size() <= 10000 &&
             ( !('summary' in data) || (data.summary is string && data.summary.size() <= 1000) ) &&
             ( !('imageUrl' in data) || (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2097152)) ) && // 2MB limit for news image
             data.createdAt is timestamp &&
             data.author is string;
    }

    match /news/{newsId} {
      allow read: if true; // News is public
      allow create: if isAdmin() && isValidNews(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidNews(incoming());
      allow delete: if isAdmin();
    }
  }
}
