{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account details and balance",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "balance": { "type": "number", "description": "User's current simulated balance" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "balance", "role", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction Record",
      "description": "Record of deposits, trades, and withdrawals",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "trade", "withdraw"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "details": { "type": "string", "description": "Optional details about the trade or withdrawal" }
      },
      "required": ["userId", "type", "amount", "status", "createdAt"]
    },
    "Settings": {
      "title": "Global Settings",
      "description": "Platform settings like crypto addresses",
      "type": "object",
      "properties": {
        "btc_address": { "type": "string" },
        "eth_address": { "type": "string" },
        "xrp_address": { "type": "string" }
      },
      "required": ["btc_address", "eth_address", "xrp_address"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user accounts"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "History of all transactions"
    },
    "/settings/addresses": {
      "schema": "Settings",
      "description": "Global crypto deposit addresses"
    }
  }
}
