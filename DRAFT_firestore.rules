rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'habeshatilaye@gmail.com' && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || isBootstrappedAdmin());
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'balance', 'role', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.email is string && data.email.size() <= 200 &&
             data.balance is number &&
             data.role in ['user', 'admin'] &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == 'user' && // Self-registered are always 'user'
                      incoming().balance == 0;      // Start with zero balance
      
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Action: Update Balance (Admin only or restricted logic)
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'role'])) ||
        // Action: User can only update nothing? Or maybe profile?
        // For simulation, we might allow the trade logic to update balance if we trust the client (unsecured)
        // But the user requested /update-balance (admin only).
        // Let's allow users to update only if it's a balance change from a trade... 
        // Actually, let's keep it STRICT: only Admin can update balance directly.
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([]))
      ) && isValidUser(incoming());
    }

    // --- Transaction Validation ---
    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'status', 'createdAt']) &&
             data.keys().size() >= 5 &&
             data.userId is string &&
             data.type in ['deposit', 'trade', 'withdraw'] &&
             data.amount is number &&
             data.status in ['pending', 'completed', 'failed'] &&
             data.createdAt is timestamp;
    }

    match /transactions/{transactionId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      
      allow create: if isSignedIn() && 
                      isValidId(transactionId) && 
                      isValidTransaction(incoming()) &&
                      isOwner(incoming().userId) &&
                      incoming().status == 'pending' &&
                      incoming().createdAt == request.time;

      allow update: if isAdmin() && 
                      isValidTransaction(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasAny(['status', 'amount']);
    }

    // --- Settings Validation ---
    function isValidSettings(data) {
      return data.keys().hasAll(['btc_address', 'eth_address', 'xrp_address']) &&
             data.keys().size() == 3 &&
             data.btc_address is string && data.btc_address.size() <= 100 &&
             data.eth_address is string && data.eth_address.size() <= 100 &&
             data.xrp_address is string && data.xrp_address.size() <= 100;
    }

    match /settings/addresses {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidSettings(incoming());
    }

    // --- Admin List ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable through Firebase Console or backend
    }
  }
}
